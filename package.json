{
  "name": "locational-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public/map-styles"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode library && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run lint && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "@turf/turf": "^7.0.0",
    "3d-tiles-renderer": "^0.5.0",
    "gsap": "^3.0.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.179.0"
  },
  "peerDependenciesMeta": {
    "3d-tiles-renderer": {
      "optional": true
    },
    "gsap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@turf/turf": "^7.2.0",
    "3d-tiles-renderer": "^0.5.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "gsap": "^3.13.0",
    "maplibre-gl": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
